__pycache__/

# build and run artifacts - generated, never committed. programs/build.py
# writes the .bin, .lst and .asm artifacts beside each .hl source for the
# whole gallery, and tools/compile.py writes the same three on demand:
# the .lst is the dipswitch entry table for loading the machine by hand,
# the .bin is for the headless runner. The .hl sources and
# programs/verify.py's expectations table are what is tracked.
# roms/*.hex are NOT artifacts: they are the machine's own ROM contents,
# the pinned images every build consumes - tracked on purpose.
programs/*.hex
programs/*.lst
programs/*.bin
programs/*.asm
