__pycache__/

# build and run artifacts - generated, never committed. web/build.py
# writes programs/*.bin, *.lst and *.asm for the whole gallery, and
# tools/compile.py writes the same three on demand: the .lst is the
# dipswitch entry table for loading the machine by hand, the .bin is
# for the headless runner. The .hl sources and web/test/verify.py's
# expectations table are what is tracked.
# roms/*.hex are NOT artifacts: they are the machine's own ROM contents,
# the pinned images every build consumes - tracked on purpose.
programs/*.hex
programs/*.lst
programs/*.bin
programs/*.asm
