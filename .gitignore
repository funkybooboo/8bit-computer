__pycache__/

# build and run artifacts - generated, never committed. programs/*.hex are
# generated for the web app by web/build.py; the .asm sources and
# web/test/verify.py's expectations table are what is tracked.
# roms/*.hex are NOT artifacts: they are the machine's own ROM contents,
# the pinned images every build consumes - tracked on purpose.
programs/*.hex
programs/*.lst
programs/*.bin
programs/*.out
