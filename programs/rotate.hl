; rotate.hl - rotate a bit left through carry: 1, 2, 4, ..., 128, 1
; The rotate idiom: DBL shifts (CF = the bit that fell off the top),
; JNC skips the fixup when nothing fell off, ADDI 1 wraps the
; carried bit into bit 0. With seed 1 a single light chases around
; the byte.
var s = 1
while 1:
    if s >= 128:
        s = s * 2 + 1
    else:
        s = s * 2
    out s
