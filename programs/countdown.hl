; countdown.hl - count down from 255 to 0, then halt
; The 255 comes from an underflow: 0 - 1 wraps to 255, so the start
; value never has to be stored (operand fields only carry 0-15, so 255
; cannot come from an instruction anyway). The pass (NOP) is pacing:
; idle microsteps slow the countdown's display.
var n = 0
n = n - 1
while n != 0:
    out n
    pass
    n = n - 1
out n
halt
