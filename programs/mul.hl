; mul.hl - multiplication as a counting loop: 7 * 6
; The hardware has no multiply; the language enforces that (e * e is
; rejected), so the loop is written out: r += x, y times. y = 0 runs
; 256 laps and still ends right: x*0 and x*256 are the same byte
; (mod 256).
var r = 0
var x = 7
var y = 6
while y != 0:
    r = r + x
    out r
    y = y - 1
halt
