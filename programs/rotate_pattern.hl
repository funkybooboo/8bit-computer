; rotate_pattern.hl - rotate a pattern left through carry: 0b1011 circling
; The same idiom as rotate_bit.hl with a wider seed: x >= 128 is the DBL
; top-bit test, x * 2 + 1 is the rotate. The pattern is back where
; it started after 8 laps.
var x = 0b1011
while 1:
    if x >= 128:
        x = x * 2 + 1
    else:
        x = x * 2
    out x
